<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store: run in the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- User picks the root photo folder via NSOpenPanel; we read images and
	     write NP_ Finder tags (extended attribute) on files under it. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Persist access to the chosen root across launches via a
	     security-scoped bookmark. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
